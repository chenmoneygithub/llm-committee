# Experiment outputs (raw per-question trajectory JSONs, generated reports, MLflow, eval CSVs).
# Rendered reports we want to keep live under top-level reports/<date>/ instead.
simpleqa_experiment/results/
gaia_committee_results/
gaia_baseline_results/
eval_results/
mlruns/
*.heapsnapshot

# EXCEPTION — preserved raw experiment data. LLM debates are expensive and non-reproducible
# (endpoints drift, models deprecate), so every committed run archives its raw per-question
# trajectory JSONs as compressed .jsonl.gz under reports/<date>/raw/. These must survive the
# blanket *.json and results/ rules above, so we force-include the raw archive tree.
!reports/**/raw/
!reports/**/raw/**

# LaTeX/PDF toolchain (self-contained tectonic binary + downloads — do not commit)
.tooling/

.claude/skills/
